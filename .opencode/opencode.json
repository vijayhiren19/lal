{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "sqlite": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-sqlite",
        "--db-path",
        "mydb1.db"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "edit": {
      "*": "deny",
      "*.py": "allow",
      "**/*.py": "allow",
      "*.md": "allow",
      "**/*.md": "allow",
      "*.skill.md": "allow",
      "**/*.skill.md": "allow",
      "*.yml": "allow",
      "**/*.yml": "allow",
      "*.html": "allow",
      "**/*.html": "allow",
      "*.css": "allow",
      "**/*.css": "allow",
      "*.js": "allow",
      "**/*.js": "allow",
      ".opencode/**": "allow",
      "*.json": "allow",
      "**/*.json": "allow",
      ".gitignore": "allow",
      "**/.gitignore": "allow"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": {
          "*": "deny",
          "*.md": "allow",
          "**/*.md": "allow",
          ".opencode/**/*.md": "allow"
        }
      }
    }
  }
}
